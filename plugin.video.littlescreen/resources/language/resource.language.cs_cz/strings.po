msgctxt "#30000"
msgid "Profiles"
msgstr "Profily"

msgctxt "#30001"
msgid "Profile 1"
msgstr "Profil 1"

msgctxt "#30002"
msgid "Profile 2"
msgstr "Profil 2"

msgctxt "#30003"
msgid "Profile 3"
msgstr "Profil 3"

msgctxt "#30010"
msgid "Show this profile"
msgstr "Zobrazit tento profil"

msgctxt "#30011"
msgid "Name"
msgstr "Jméno"

msgctxt "#30012"
msgid "Age group"
msgstr "Věk"

msgctxt "#30013"
msgid "4 and under"
msgstr "Do 4 let"

msgctxt "#30014"
msgid "5 to 8"
msgstr "5 až 8 let"

msgctxt "#30015"
msgid "9 to 12"
msgstr "9 až 12 let"

msgctxt "#30016"
msgid "Look"
msgstr "Vzhled"

msgctxt "#30017"
msgid "Big pictures (toddlers)"
msgstr "Velké obrázky (batolata)"

msgctxt "#30018"
msgid "List with titles"
msgstr "Seznam s názvy"

msgctxt "#30019"
msgid "Allow search"
msgstr "Povolit hledání"

msgctxt "#30020"
msgid "Language and region"
msgstr "Jazyk a oblast"

msgctxt "#30021"
msgid "Language"
msgstr "Jazyk"

msgctxt "#30022"
msgid "Region"
msgstr "Oblast"

msgctxt "#30023"
msgid "Videos in"
msgstr "Jazyk videí"

msgctxt "#30024"
msgid "Any language"
msgstr "Všechna"

msgctxt "#30025"
msgid "All but Slovak"
msgstr "Bez slovenských"

msgctxt "#30026"
msgid "Czech only"
msgstr "Jen česká"

msgctxt "#30046"
msgid "Guessed from titles and channel names. \"Czech only\" also hides other languages; videos whose language is unclear stay."
msgstr "Odhaduje se z názvů videí a kanálů. „Jen česká“ skryje i jiné jazyky; videa s nejasným jazykem zůstanou."

msgctxt "#30027"
msgid "Play the next video automatically"
msgstr "Automaticky přehrát další video"

msgctxt "#30047"
msgid "After the picked video, the following videos of the same list play (up to 50)."
msgstr "Po vybraném videu se pustí další videa ze stejného seznamu (nejvýš 50)."

msgctxt "#30030"
msgid "Search"
msgstr "Hledat"

msgctxt "#30031"
msgid "More videos"
msgstr "Další videa"

msgctxt "#30032"
msgid "Cannot load the catalogue"
msgstr "Katalog se nepodařilo načíst"

msgctxt "#30033"
msgid "No profile is turned on. Turn one on in the add-on settings."
msgstr "Žádný profil není zapnutý. Zapněte ho v nastavení doplňku."

msgctxt "#30034"
msgid "Nothing found"
msgstr "Nic nenalezeno"

msgctxt "#30035"
msgid "Who is watching?"
msgstr "Kdo se dívá?"

msgctxt "#30040"
msgid "With one profile on, the add-on opens it straight away."
msgstr "Když je zapnutý jen jeden profil, doplněk ho otevře rovnou."

msgctxt "#30041"
msgid "YouTube Kids picks videos suitable for this age."
msgstr "YouTube Kids vybírá videa vhodná pro tento věk."

msgctxt "#30042"
msgid "Big pictures: no text, no search. List: titles, channel names and search."
msgstr "Velké obrázky: bez textu a bez hledání. Seznam: názvy, kanály a hledání."

msgctxt "#30043"
msgid "Searches only the YouTube Kids catalogue for this age."
msgstr "Hledá jen v katalogu YouTube Kids pro tento věk."

msgctxt "#30044"
msgid "Language of titles and categories, for example cs or en."
msgstr "Jazyk názvů a kategorií, například cs nebo en."

msgctxt "#30045"
msgid "Country whose catalogue is shown, for example CZ or SK."
msgstr "Země, jejíž katalog se zobrazí, například CZ nebo SK."
