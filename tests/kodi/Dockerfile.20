# Kodi 20 (Nexus) from Debian 12
FROM debian:bookworm-slim
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        kodi kodi-inputstream-adaptive xvfb xauth libgl1-mesa-dri python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home kodi
USER kodi
WORKDIR /home/kodi
COPY fetch_addons.py entrypoint.sh /opt/kodi-check/
RUN python3 /opt/kodi-check/fetch_addons.py nexus plugin.video.youtube
ENTRYPOINT ["/opt/kodi-check/entrypoint.sh"]
